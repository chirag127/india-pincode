{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chirag127.github.io/india-pincode/data/schema.json",
  "title": "India PIN Code Directory",
  "description": "All 155000+ PIN codes with post office, district, state, and coordinates",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name"
    ],
    "properties": {
      "id": {
        "type": "string",
        "description": "Unique identifier"
      },
      "name": {
        "type": "string",
        "description": "Display name"
      }
    }
  }
}
